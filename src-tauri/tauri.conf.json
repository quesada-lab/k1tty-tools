{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K1tty Tools",
  "version": "2.1.1",
  "identifier": "lab.quesada.k1tty-tools",
  "build": {
    "beforeBuildCommand": "npm run build:ui",
    "beforeDevCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "K1tty Tools",
        "width": 1280,
        "height": 840,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false,
        "devtools": false,
        "zoomHotkeysEnabled": false,
        "allowLinkPreview": false,
        "backgroundColor": "#0c0d0f",
        "shadow": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local AI conversation editor and migration tool",
    "longDescription": "View, edit, back up and transfer local histories for Antigravity, Antigravity CLI, Codex, Claude Code and OpenCode.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Russian",
          "Ukrainian"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
